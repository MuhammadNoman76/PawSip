<Window x:Class="PawSip.Views.CatWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PawSip.Controls"
        Title="PawSip cat"
        Width="300" Height="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource Body}" Foreground="{StaticResource Ink}" UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Speech bubble (reminders, thanks) -->
        <Grid x:Name="Bubble" VerticalAlignment="Bottom" Margin="0,0,0,-6" RenderTransformOrigin="0.5,1" Visibility="Collapsed">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" />
            </Grid.RenderTransform>
            <Border Background="White" CornerRadius="22" Padding="18,14,14,14" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Button x:Name="DismissButton" Style="{StaticResource IconButton}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-6,-6,0" ToolTip="Dismiss">
                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="12" Height="12" Fill="{StaticResource Ink3}" />
                    </Button>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,26,0">
                            <Path Data="{StaticResource Icon.Drop}" Fill="{StaticResource WaterGradient}" Width="15" Height="15" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="MessageText" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="210"
                                       Text="Meow! Time to drink some water!" />
                        </StackPanel>
                        <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="DrankButton" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Drop}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="I drank water" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LaterButton" Style="{StaticResource SoftButton}" Height="36" Margin="8,0,0,0" FontSize="13"
                                    Background="{StaticResource LavenderTint}" Foreground="#6B5FD6" Content="Remind me later" />
                        </StackPanel>
                        <ContentControl x:Name="SnoozeHost" Margin="0,12,0,0" Visibility="Collapsed" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Border>
            <Path Data="M 0,0 L 22,0 L 6,16 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-24,0,0,0" />
        </Grid>

        <!-- Cat + water gauge -->
        <Grid x:Name="Body" Grid.Row="1" Width="236" HorizontalAlignment="Center" Background="#01FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <c:CatView x:Name="Cat" Width="120" Height="122" HorizontalAlignment="Center" Cursor="Hand" ToolTip="Drag me anywhere · click to pet" />

            <StackPanel x:Name="HoverButtons" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                <Button x:Name="DrinkButton" Style="{StaticResource IconButton}" Width="42" Height="42" Background="{StaticResource WaterGradient}"
                        ToolTip="I drank a glass" Effect="{StaticResource ButtonGlow}">
                    <Grid>
                        <Path Data="{StaticResource Icon.Drop}" Fill="White" Width="16" Height="16" Stretch="Uniform" />
                        <Path Data="{StaticResource Icon.Plus}" Fill="White" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-3" />
                    </Grid>
                </Button>
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Width="32" Height="32" Background="White" Margin="5,8,5,0" ToolTip="Undo last drink"
                        Effect="{StaticResource SoftShadow}">
                    <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource Icon}" Width="14" Height="14" Fill="{StaticResource Ink2}" />
                </Button>
                <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Width="32" Height="32" Background="White" Margin="5,8,5,0" ToolTip="Open PawSip"
                        Effect="{StaticResource SoftShadow}">
                    <Path Data="{StaticResource Icon.Home}" Style="{StaticResource Icon}" Width="14" Height="14" Fill="{StaticResource Ink2}" />
                </Button>
                <Button x:Name="HideButton" Style="{StaticResource IconButton}" Width="32" Height="32" Background="White" Margin="5,8,5,0" ToolTip="Hide the widget"
                        Effect="{StaticResource SoftShadow}">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="11" Height="11" Fill="{StaticResource Ink2}" />
                </Button>
            </StackPanel>

            <Border x:Name="Pill" Grid.Row="1" HorizontalAlignment="Center" Background="White" CornerRadius="14" Padding="12,6,12,8" Margin="0,0,0,4"
                    Effect="{StaticResource SoftShadow}" Cursor="Hand" ToolTip="Open PawSip">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource Icon.Drop}" Fill="{StaticResource WaterGradient}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock x:Name="AmountText" FontSize="12.5" FontWeight="SemiBold" Text="0 / 2,000 ml" />
                    </StackPanel>
                    <Grid Width="112" Height="4" Margin="0,6,0,0">
                        <Border CornerRadius="2" Background="{StaticResource WaterTint}" />
                        <Border x:Name="ProgressFill" CornerRadius="2" Background="{StaticResource WaterGradient}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

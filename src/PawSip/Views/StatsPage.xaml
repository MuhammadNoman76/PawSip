<UserControl x:Class="PawSip.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PawSip.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel Margin="0,0,0,26">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Statistics" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" Text="See how well you and your cat kept hydrated." />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" CornerRadius="21" Padding="4" Effect="{StaticResource SoftShadow}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WeekMode" Style="{StaticResource Chip}" Margin="0" Content="Week" IsChecked="True" GroupName="StatsMode" />
                        <RadioButton x:Name="MonthMode" Style="{StaticResource Chip}" Margin="4,0,0,0" Content="Month" GroupName="StatsMode" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Range navigation -->
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Background="White" ToolTip="Previous">
                        <Path Data="{StaticResource Icon.ChevronLeft}" Style="{StaticResource Icon}" Width="16" Height="16" />
                    </Button>
                    <TextBlock x:Name="RangeText" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0" Text="Oct 6 – 12" />
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Background="White" ToolTip="Next">
                        <Path Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" Width="16" Height="16" />
                    </Button>
                </StackPanel>
                <Button x:Name="TodayButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="Back to today" Foreground="{StaticResource WaterDeep}" />
            </Grid>

            <!-- Summary -->
            <UniformGrid Columns="4" Margin="-9,0,-9,0">
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Daily average" />
                        <TextBlock x:Name="AvgValue" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{StaticResource WaterDeep}" Text="0 ml" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Goal reached" />
                        <TextBlock x:Name="MetValue" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{StaticResource Mint}" Text="0 days" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Best day" />
                        <TextBlock x:Name="BestValue" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{StaticResource Lavender}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Total water" />
                        <TextBlock x:Name="TotalValue" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{StaticResource Peach}" Text="0 L" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Chart -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ChartTitle" Style="{StaticResource H2}" Text="Daily intake" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource WaterGradient}" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="Goal met" Margin="0,0,14,0" />
                            <Ellipse Width="10" Height="10" Fill="#C9C2FB" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="Below goal" Margin="0,0,14,0" />
                            <Border Width="14" Height="2" Background="{StaticResource Pink}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Caption}" Text="Goal" />
                        </StackPanel>
                    </Grid>
                    <c:BarChart x:Name="Chart" Height="260" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Month calendar -->
            <Border x:Name="CalendarCard" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Hydration calendar" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,14" Text="Deeper blue means more of your goal was reached." />
                    <c:MonthHeatmap x:Name="Heatmap" Height="330" MaxWidth="560" HorizontalAlignment="Left" Width="560" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

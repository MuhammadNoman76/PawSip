<Window x:Class="PawSip.Views.CatReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PawSip.Controls"
        Title="PawSip reminder"
        Width="340" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource Body}" Foreground="{StaticResource Ink}" UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Speech bubble -->
        <Grid x:Name="Bubble" VerticalAlignment="Bottom" Margin="0,0,0,-4" RenderTransformOrigin="0.5,1" Opacity="0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="0.6" ScaleY="0.6" />
            </Grid.RenderTransform>
            <Border Background="White" CornerRadius="24" Padding="20,16,16,16" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Button x:Name="DismissButton" Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-6,-6,0" ToolTip="Dismiss">
                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="13" Height="13" Fill="{StaticResource Ink3}" />
                    </Button>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                            <Path Data="{StaticResource Icon.Drop}" Fill="{StaticResource WaterGradient}" Width="16" Height="16" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="MessageText" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="230"
                                       Text="Meow! Time to drink some water!" />
                        </StackPanel>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Margin="24,6,0,0" Text="750 / 2,000 ml · 5 glasses to go" />
                        <Grid Margin="24,8,6,0" Height="6">
                            <Border CornerRadius="3" Background="{StaticResource WaterTint}" />
                            <Border x:Name="ProgressFill" CornerRadius="3" Background="{StaticResource WaterGradient}" HorizontalAlignment="Left" Width="40" />
                        </Grid>
                        <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="DrankButton" Style="{StaticResource PrimaryButton}" Height="40" Padding="16,0" FontSize="13.5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Drop}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" />
                                    <TextBlock Text="I drank water" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LaterButton" Style="{StaticResource SoftButton}" Height="40" Margin="8,0,0,0" Background="{StaticResource LavenderTint}"
                                    Foreground="#6B5FD6" Content="Remind me later" />
                        </StackPanel>
                        <ContentControl x:Name="SnoozeHost" Margin="0,12,0,0" Visibility="Collapsed" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- bubble tail -->
            <Path Data="M 0,0 L 22,0 L 6,16 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-30,0,0,0" />
        </Grid>

        <!-- The cat -->
        <c:CatView x:Name="Cat" Grid.Row="1" Width="150" Height="153" HorizontalAlignment="Center" Cursor="Hand" ToolTip="Drag me anywhere · click to pet" />
    </Grid>
</Window>

<UserControl x:Class="PawSip.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PawSip.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel Margin="0,0,0,26">

            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="Greeting" Style="{StaticResource H1}" Text="Good afternoon" />
                    <TextBlock x:Name="SubGreeting" Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" Text="Let's keep you hydrated today." />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" CornerRadius="18" Padding="16,9" Effect="{StaticResource SoftShadow}">
                    <TextBlock x:Name="DateText" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" Text="Monday, Oct 12" />
                </Border>
            </Grid>

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="30,26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="236" Height="236">
                        <c:WaterRing x:Name="Ring" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-6,0,0">
                            <TextBlock x:Name="AmountText" FontFamily="{StaticResource Display}" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Text="0" />
                            <TextBlock x:Name="GoalText" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" Text="of 2,000 ml" />
                            <Border CornerRadius="11" Padding="11,3" Margin="0,9,0,0" HorizontalAlignment="Center" Background="#D9FFFFFF">
                                <TextBlock x:Name="PercentText" FontWeight="Bold" Foreground="{StaticResource WaterDeep}" FontSize="13" Text="0%" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" Margin="34,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:CatView x:Name="Cat" Width="118" Height="120" Cursor="Hand" ToolTip="Pet me!" />
                            <Border Grid.Column="1" Margin="8,0,0,18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{StaticResource WaterTint}" CornerRadius="20,20,20,6" Padding="18,13">
                                <TextBlock x:Name="CatSays" TextWrapping="Wrap" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" MaxWidth="300"
                                           Text="Meow! Let's drink some water today." />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid HorizontalAlignment="Left">
                                <Ellipse x:Name="Ripple" Width="60" Height="60" Fill="{StaticResource Water}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RippleScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Button x:Name="DrinkButton" Style="{StaticResource PrimaryButton}" Height="54" Padding="28,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Drop}" Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock x:Name="DrinkButtonText" Text="Drink a glass · 250 ml" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="AddSmall" Style="{StaticResource SoftButton}" Content="+ 100 ml" Margin="0,0,8,0" />
                                <Button x:Name="AddLarge" Style="{StaticResource SoftButton}" Content="+ 500 ml" Margin="0,0,8,0" />
                                <Button x:Name="AddCustom" Style="{StaticResource SoftButton}" Background="{StaticResource LavenderTint}" Foreground="#6B5FD6" Content="Custom…" Margin="0,0,8,0" />
                                <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" ToolTip="Remove the last drink">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource Icon}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Undo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBox x:Name="CustomBox" Style="{StaticResource SoftTextBox}" Width="120" Text="330" />
                                <TextBlock Text="ml" VerticalAlignment="Center" Margin="8,0,12,0" Foreground="{StaticResource Ink2}" />
                                <Button x:Name="CustomAdd" Style="{StaticResource SoftButton}" Content="Add" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- celebration particles -->
                    <Canvas x:Name="Confetti" Grid.ColumnSpan="2" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Stat cards -->
            <UniformGrid Columns="4" Margin="-9,18,-9,0">
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource WaterTint}" HorizontalAlignment="Left">
                            <Path Data="{StaticResource Icon.Glass}" Fill="{StaticResource Water}" Width="19" Height="19" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="RemainingValue" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" Text="6 glasses" />
                        <TextBlock x:Name="RemainingCaption" Style="{StaticResource Caption}" Text="1,500 ml to go" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource LavenderTint}" HorizontalAlignment="Left">
                            <Path Data="{StaticResource Icon.Bell}" Fill="{StaticResource Lavender}" Width="19" Height="19" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="NextValue" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" Text="3:45 PM" />
                        <TextBlock x:Name="NextCaption" Style="{StaticResource Caption}" Text="next reminder" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource PeachTint}" HorizontalAlignment="Left">
                            <Path Data="{StaticResource Icon.Fire}" Fill="{StaticResource Peach}" Width="19" Height="19" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="StreakValue" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" Text="0 days" />
                        <TextBlock Style="{StaticResource Caption}" Text="goal streak" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9" Padding="18">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{StaticResource MintTint}" HorizontalAlignment="Left">
                            <Path Data="{StaticResource Icon.Trophy}" Fill="{StaticResource Mint}" Width="19" Height="19" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="PaceValue" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" Text="On track" />
                        <TextBlock x:Name="PaceCaption" Style="{StaticResource Caption}" Text="today's pace" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bottom row -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Today's sips" />
                        <TextBlock x:Name="GlassesLine" Style="{StaticResource Caption}" Margin="0,3,0,12" Text="0 glasses so far" />
                        <WrapPanel x:Name="CupRow" Margin="0,0,0,10" />
                        <StackPanel x:Name="SipList" />
                        <TextBlock x:Name="EmptySips" Style="{StaticResource Caption}" Margin="0,6,0,0" Text="No sips yet — tap the big button to log your first glass!" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="This week" />
                                <TextBlock x:Name="WeekCaption" Style="{StaticResource Caption}" Margin="0,3,0,0" Text="Average 1,850 ml a day" />
                            </StackPanel>
                            <Button x:Name="StatsLink" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource WaterDeep}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Statistics" VerticalAlignment="Center" />
                                    <Path Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" Width="14" Height="14" Fill="{StaticResource WaterDeep}" Margin="2,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <c:BarChart x:Name="WeekChart" Grid.Row="1" Height="190" Margin="0,14,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

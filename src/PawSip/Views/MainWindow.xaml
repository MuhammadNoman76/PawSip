<Window x:Class="PawSip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PawSip"
        Width="1080" Height="740" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource Body}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- Soft pastel blobs -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="620" Height="620" Canvas.Left="640" Canvas.Top="-300">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40A9DDFD" Offset="0" />
                        <GradientStop Color="#00A9DDFD" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="520" Height="520" Canvas.Left="120" Canvas.Top="460">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33FFC2D6" Offset="0" />
                        <GradientStop Color="#00FFC2D6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="460" Height="460" Canvas.Left="760" Canvas.Top="420">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2EC8BFFB" Offset="0" />
                        <GradientStop Color="#00C8BFFB" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="#B3FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,20,18,20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,30">
                        <Image Source="/Assets/PawSip-256.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PawSip" FontFamily="{StaticResource Display}" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Stay hydrated, meow~" FontSize="12" Foreground="{StaticResource Ink3}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status card -->
                    <Border DockPanel.Dock="Bottom" CornerRadius="20" Padding="16" Background="{StaticResource WaterGradient}">
                        <StackPanel>
                            <TextBlock x:Name="NextLabel" Text="Next reminder" Foreground="#E6FFFFFF" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="NextTime" Text="3:45 PM" Foreground="White" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Margin="0,2,0,10" />
                            <Button x:Name="PauseButton" Style="{StaticResource SoftButton}" Background="#33FFFFFF" Foreground="White" Height="34" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="PauseIcon" Data="{StaticResource Icon.Pause}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" />
                                    <TextBlock x:Name="PauseText" Text="Pause 1 hour" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Home}" Content="Dashboard" IsChecked="True" />
                        <RadioButton x:Name="NavStats" Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Stats}" Content="Statistics" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Settings}" Content="Settings" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                        <Path Data="M 0,0 L 10,0" Stroke="{StaticResource Ink2}" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
                        <Border Width="10" Height="10" BorderBrush="{StaticResource Ink2}" BorderThickness="1.4" CornerRadius="2" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close to tray">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource Ink2}" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>

                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="30,0,30,0" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>

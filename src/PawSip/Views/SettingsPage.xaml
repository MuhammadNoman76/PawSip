<UserControl x:Class="PawSip.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,26">
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Style="{StaticResource H1}" Text="Settings" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" Text="Changes are saved automatically." />
                </StackPanel>
                <StackPanel x:Name="Body" />
            </StackPanel>
        </ScrollViewer>

        <!-- "Saved" pill -->
        <Border x:Name="SavedPill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0" Background="{StaticResource MintTint}"
                CornerRadius="16" Padding="14,7" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="{StaticResource Mint}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                <TextBlock Text="Saved" FontWeight="SemiBold" Foreground="#2E9C78" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

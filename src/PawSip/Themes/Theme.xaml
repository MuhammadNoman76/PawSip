<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Palette ===================== -->
    <Color x:Key="BgColor">#F6F7FC</Color>
    <Color x:Key="InkColor">#2E3352</Color>
    <Color x:Key="Ink2Color">#6E7491</Color>
    <Color x:Key="Ink3Color">#A3A9C2</Color>
    <Color x:Key="LineColor">#ECEEF6</Color>
    <Color x:Key="WaterColor">#5BB6F6</Color>
    <Color x:Key="WaterDeepColor">#3E8FE8</Color>
    <Color x:Key="PeriwinkleColor">#7C8CFF</Color>
    <Color x:Key="PinkColor">#FF8DB3</Color>
    <Color x:Key="MintColor">#5CCFA9</Color>
    <Color x:Key="PeachColor">#FFB27D</Color>
    <Color x:Key="LavenderColor">#A497F7</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="White" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Ink2" Color="{StaticResource Ink2Color}" />
    <SolidColorBrush x:Key="Ink3" Color="{StaticResource Ink3Color}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Water" Color="{StaticResource WaterColor}" />
    <SolidColorBrush x:Key="WaterDeep" Color="{StaticResource WaterDeepColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="Mint" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="Peach" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="Lavender" Color="{StaticResource LavenderColor}" />

    <SolidColorBrush x:Key="WaterTint" Color="#EAF5FF" />
    <SolidColorBrush x:Key="PinkTint" Color="#FFEEF4" />
    <SolidColorBrush x:Key="MintTint" Color="#E7F8F2" />
    <SolidColorBrush x:Key="PeachTint" Color="#FFF2E8" />
    <SolidColorBrush x:Key="LavenderTint" Color="#F1EFFE" />
    <SolidColorBrush x:Key="Field" Color="#F3F5FB" />

    <LinearGradientBrush x:Key="WaterGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6CC5FF" Offset="0" />
        <GradientStop Color="#7C8CFF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.08" Color="#5468A8" />
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#5468A8" />
    <DropShadowEffect x:Key="ButtonGlow" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.35" Color="#5B8CF6" />


<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Two editions from one source:
      net10.0-windows  Windows 10 / 11, self-contained (x64, x86 or ARM64 via -r win-...)
      net48            Windows 7 SP1 / 8 / 8.1 (and newer), uses the .NET Framework 4.8 built into Windows
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PawSip</AssemblyName>
    <RootNamespace>PawSip</RootNamespace>
    <ApplicationIcon>Assets\PawSip.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.2</Version>
    <Product>PawSip</Product>
    <Company>Muhammad Noman</Company>
    <Authors>Muhammad Noman</Authors>
    <Description>PawSip - a cute cat that reminds you to drink water</Description>
    <Copyright>Copyright © 2026 Muhammad Noman</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Keep the background footprint small -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!--
    Which installer this build belongs to (x64, arm64, x86 or win7-8): the updater downloads the same edition.
    build.ps1 passes -p:PawSipEdition=...; otherwise it follows the target.
  -->
  <PropertyGroup>
    <PawSipEdition Condition="'$(PawSipEdition)' == '' and '$(TargetFramework)' == 'net48'">win7-8</PawSipEdition>
    <PawSipEdition Condition="'$(PawSipEdition)' == '' and '$(RuntimeIdentifier)' == 'win-arm64'">arm64</PawSipEdition>
    <PawSipEdition Condition="'$(PawSipEdition)' == '' and '$(RuntimeIdentifier)' == 'win-x86'">x86</PawSipEdition>
    <PawSipEdition Condition="'$(PawSipEdition)' == ''">x64</PawSipEdition>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Edition" Value="$(PawSipEdition)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PawSip.ico" />
    <Resource Include="Assets\PawSip-256.png" />
  </ItemGroup>

</Project>

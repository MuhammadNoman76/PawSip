<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PawSip</AssemblyName>
    <RootNamespace>PawSip</RootNamespace>
    <ApplicationIcon>Assets\PawSip.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.0</Version>
    <Product>PawSip</Product>
    <Company>Muhammad Noman</Company>
    <Authors>Muhammad Noman</Authors>
    <Description>PawSip - a cute cat that reminds you to drink water</Description>
    <Copyright>Copyright © 2026 Muhammad Noman</Copyright>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Keep the background footprint small -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PawSip.ico" />
    <Resource Include="Assets\PawSip-256.png" />
  </ItemGroup>

</Project>
